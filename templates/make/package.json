    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@figma/fpl-components": "0.0.2-release-test.3",
    "@figma/fpl-icons": "0.0.1-release-test.3",
