    "@figma/ppg-ui": "^0.1.0",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.13.0",
    "zod": "^3.25.58"
  },
  "devDependencies": {
    "@figma/ppg-eslint-config": "^0.1.0",
    "@figma/ppg-tailwind-config": "^0.1.0",
    "@figma/ppg-tsconfig": "^0.1.0",
    "@figma/ppg-vite-config": "^0.1.0",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.56.0",
