{
  "name": "@prototype/make",
  "version": "1.0.0",
  "private": true,
  "template": {
    "displayName": "Figma Make"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
