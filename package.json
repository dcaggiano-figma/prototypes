{
  "name": "prototype-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "pnpm": {
    "overrides": {
      "@figma/fpl-tokens": "0.0.1-release-test.4",
      "@figma/fpl-components": "0.0.2-release-test.4",
      "@figma/fpl-icons": "0.0.1-release-test.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@figma/ppg-dev-tools": "^0.7.0",
    "tsx": "^4.19.2"
  },
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm -r --filter './templates/*' build && pnpm --filter @apps/prototype build",
    "lint": "pnpm -r --filter './templates/*' lint",
    "typecheck": "pnpm -r --filter './templates/*' typecheck",
    "verify": "pnpm -r --filter './templates/*' verify"
  }
}
